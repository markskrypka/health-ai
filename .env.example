# Copy to .env and fill in. Never commit .env.
PROSPER_BASE_URL=https://hackspain.getprosperapp.com
# Team API key from the desk, sent as X-Api-Key
PROSPER_API_KEY=
# Dashboard login — only for scripts that trigger practice calls and read results
PROSPER_DASHBOARD_EMAIL=
PROSPER_DASHBOARD_PASSWORD=
# Gemini API key (Google AI Studio): the model that decides
GOOGLE_API_KEY=
# Deepgram key: speech-to-text (Nova-3) and text-to-speech (Aura-2) on one key
DEEPGRAM_API_KEY=
# Static ngrok domain, e.g. your-name.ngrok-free.app
NGROK_DOMAIN=
# Optional
OPENAI_API_KEY=
